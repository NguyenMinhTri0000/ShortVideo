# Database & Storage Configuration
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:25432/videotool?schema=public"
REDIS_HOST="127.0.0.1"
REDIS_PORT=26379

MINIO_ENDPOINT="127.0.0.1"
MINIO_PORT=29000
MINIO_USE_SSL="false"
MINIO_PUBLIC_ENDPOINT="127.0.0.1"
MINIO_PUBLIC_PORT=29000
MINIO_PUBLIC_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="videos"

PORT=23001
FRONTEND_URL="http://localhost:23000"
OAUTH_REDIRECT_BASE_URL="http://localhost:23000"

# Social Platform Credentials

# 1. YouTube OAuth (console.cloud.google.com)
YOUTUBE_CLIENT_ID="your-youtube-client-id"
YOUTUBE_CLIENT_SECRET="your-youtube-client-secret"
# YOUTUBE_REDIRECT_URI="http://localhost:23000/api/publishing/accounts/youtube/callback"

# 2. TikTok OAuth (developers.tiktok.com)
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
# TIKTOK_REDIRECT_URI="http://localhost:23000/api/publishing/accounts/tiktok/callback"

# 3. Meta Facebook & Instagram OAuth (developers.facebook.com)
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
# FACEBOOK_REDIRECT_URI="http://localhost:23000/api/publishing/accounts/facebook/callback"

INSTAGRAM_CLIENT_ID="your-instagram-client-id" # Can also use FACEBOOK_APP_ID
INSTAGRAM_CLIENT_SECRET="your-instagram-client-secret" # Can also use FACEBOOK_APP_SECRET
# INSTAGRAM_REDIRECT_URI="http://localhost:23000/api/publishing/accounts/instagram/callback"
