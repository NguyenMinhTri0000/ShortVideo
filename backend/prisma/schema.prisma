datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Idea {
  id          String   @id @default(uuid())
  title       String
  topic       String
  description String?
  script      String?
  language    String   @default("vi")
  tags        String[] @default([])
  status      String   @default("draft") // draft, ready, archived
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs   GenerationJob[]
  videos Video[]

  @@map("ideas")
}

model Product {
  id              String    @id @default(uuid())
  name            String
  brand           String?
  category        String?
  description     String?
  price           String?
  originalPrice   String?
  currency        String    @default("VND")
  discountPercent Float?
  rating          Float?
  reviewCount     Int?
  affiliateUrl    String
  sourceUrl       String?
  sourcePlatform  String?   @default("generic")
  images          String[]  @default([])
  videos          String[]  @default([])
  features        String[]  @default([])
  specifications  Json?
  benefits        String[]  @default([])
  pros            String[]  @default([])
  cons            String[]  @default([])
  targetAudience  String?
  useCases        String[]  @default([])
  usp             String[]  @default([])
  painPoints      String[]  @default([])
  marketingAngles Json?
  contentBrief    Json?
  researchRawData Json?
  researchStatus  String?   // pending, processing, completed, failed, partial
  researchError   String?
  researchedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ideas        Idea[]
  jobs         GenerationJob[]
  contentIdeas ContentIdea[]
  scripts      VideoScript[]

  @@map("products")
}

model ContentIdea {
  id              String        @id @default(uuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  title           String
  description     String
  contentType     String        // product_review, problem_solution, comparison, listicle, educational, storytelling, testimonial, myth_busting, use_case, value_for_money, pros_cons, FAQ
  marketingAngle  String
  targetAudience  String
  painPoint       String
  keyMessage      String
  hook            String
  recommendedCTA  String
  priority        Int           @default(1)
  status          String        @default("draft") // draft, selected, generated, archived
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  scripts         VideoScript[]

  @@map("content_ideas")
}

model VideoScript {
  id            String       @id @default(uuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  contentIdeaId String?
  contentIdea   ContentIdea? @relation(fields: [contentIdeaId], references: [id], onDelete: SetNull)
  title         String
  duration      Int          @default(30)
  language      String       @default("vi")
  hook          String
  scenes        Json
  cta           String
  status        String       @default("ready") // draft, ready, generating, failed
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("video_scripts")
}

model GenerationJob {
  id           String    @id @default(uuid())
  ideaId       String
  idea         Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  status       String    @default("queued") // queued, running, completed, failed, cancelled
  progress     Float     @default(0)
  errorMessage String?
  config       Json      @default("{}")
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs   JobLog[]
  videos Video[]

  @@map("generation_jobs")
}

model Video {
  id                 String   @id @default(uuid())
  ideaId             String
  idea               Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  jobId              String
  job                GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title              String
  script             String?
  videoObjectKey     String
  thumbnailObjectKey String?
  subtitleObjectKey  String?
  metadataObjectKey  String?
  duration           Float?
  ratio              String   @default("9:16")
  createdAt          DateTime @default(now())

  @@map("videos")
}

model JobLog {
  id        String        @id @default(uuid())
  jobId     String
  job       GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     String        @default("info") // info, warn, error
  message   String
  createdAt DateTime      @default(now())

  @@map("job_logs")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

